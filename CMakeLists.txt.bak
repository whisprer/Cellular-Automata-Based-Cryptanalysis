cmake_minimum_required(VERSION 3.20)
project(caca LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

option(CACA_ENABLE_NATIVE "Enable -march=native (best performance on this machine)" ON)
option(CACA_ENABLE_OPENMP "Enable OpenMP if available" ON)

# If any variant needs extra .cpp files, set this at configure time:
#   -DCACA_EXTRA_SOURCES="src/foo.cpp;src/bar.cpp"
set(CACA_EXTRA_SOURCES "" CACHE STRING "Extra C++ source files (semicolon-separated) to compile into each target")

include(CheckCXXCompilerFlag)

function(caca_tune_target tgt)
  if (MSVC)
    target_compile_options(${tgt} PRIVATE /O2 /DNDEBUG)
  else()
    target_compile_options(${tgt} PRIVATE -O3 -DNDEBUG)
    if (CACA_ENABLE_NATIVE)
      target_compile_options(${tgt} PRIVATE -march=native)
    endif()
  endif()

  if (CACA_ENABLE_OPENMP)
    find_package(OpenMP)
    if (OpenMP_CXX_FOUND)
      target_link_libraries(${tgt} PRIVATE OpenMP::OpenMP_CXX)
      target_compile_definitions(${tgt} PRIVATE CACA_OPENMP=1)
    endif()
  endif()
endfunction()

# Helper: make an executable ONLY from its "main" TU (+ optional extra sources).
function(add_caca_exe target_name main_cpp)
  if (EXISTS "${main_cpp}")
    set(extra_list "")
    if (NOT "${CACA_EXTRA_SOURCES}" STREQUAL "")
      set(extra_list ${CACA_EXTRA_SOURCES})
    endif()

    add_executable(${target_name} "${main_cpp}" ${extra_list})
    caca_tune_target(${target_name})
    message(STATUS "Configured ${target_name} from ${main_cpp}")
  else()
    message(STATUS "Skipping ${target_name}; missing ${main_cpp}")
  endif()
endfunction()

# Reference / current
add_caca_exe(caca_ref "${CMAKE_SOURCE_DIR}/v-5-1-4/caca_main.cpp")

# Optional little test program
add_caca_exe(caca_test_ca "${CMAKE_SOURCE_DIR}/v-5-1-4/test_ca.cpp")

# Your expected variants (will auto-build if the files exist)
add_caca_exe(caca_fast "${CMAKE_SOURCE_DIR}/5-0-1/caca_fast.cpp")
add_caca_exe(caca_opt  "${CMAKE_SOURCE_DIR}/5-0-1/caca_optimized.cpp")
